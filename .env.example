APP_NAME=MEME HUNTER AI
APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./meme_hunter.db
# Online SQLite backups. Never restores or overwrites the live catalog. Skips test databases.
SQLITE_BACKUP_ENABLED=true
SQLITE_BACKUP_ON_STARTUP=true
SQLITE_BACKUP_DIR=./data/backups
SQLITE_BACKUP_RETAIN=14
SQLITE_BACKUP_MIN_INTERVAL_SECONDS=900
PAPER_TRADING_ENABLED=true
PAPER_STARTING_BALANCE=100
PAPER_AUTO_TRADING=false
# Phase 10A paper book. Manual simulation only. Not live execution.
PAPER_FEE_BPS=30
PAPER_MAX_SLIPPAGE_BPS=50
PAPER_SLIPPAGE_BPS=50
PAPER_MAX_QUOTE_AGE_SECONDS=60
PAPER_MAX_ALLOCATION_PCT=0.10
PAPER_MAX_EXPOSURE_PCT=0.50
PAPER_MAX_DAILY_REALIZED_LOSS_USD=10
PAPER_MAX_OPEN_POSITIONS=3
PAPER_MIN_LIQUIDITY_USD=10000
# Short-lived DexScreener HTTP cache for on-demand paper quotes. GET never fetches.
PAPER_QUOTE_CACHE_SECONDS=5
# Reject same-pair price jumps larger than this multiple (e.g. 10x).
PAPER_QUOTE_MAX_MOVE_MULTIPLE=10
# Bounded stored-evidence opportunity decisions. No provider polling. No automatic orders.
PAPER_DECISION_SCAN_LIMIT=25
PAPER_DECISION_RESCAN_SECONDS=300
# Phase 10C.1 paper auto-entry. Disabled by default. Manual POST still uses the same gates.
PAPER_AUTO_ENTRY_ENABLED=false
PAPER_AUTO_ENTRY_INTERVAL_MINUTES=5
PAPER_AUTO_ENTRY_MAX_TOKENS=10
PAPER_AUTO_ENTRY_ALLOCATION_PCT=0.05
# Phase 10C.2 paper auto-exit. Disabled by default. Manual POST uses the same stored-quote gates.
# Default percentages are not claimed to be optimal. An unfilled stop is not protection.
PAPER_AUTO_EXIT_ENABLED=false
PAPER_AUTO_EXIT_INTERVAL_SECONDS=60
PAPER_AUTO_EXIT_LEASE_SECONDS=60
PAPER_STOP_LOSS_PCT=0.10
PAPER_TAKE_PROFIT_PCT=0.20
PAPER_TRAILING_STOP_PCT=0.10
PAPER_TRAILING_ACTIVATE_PCT=0.15
PAPER_MAX_HOLD_HOURS=24
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_TIMEOUT_SECONDS=10
DEXSCREENER_MAX_RETRIES=3
DEXSCREENER_TOKEN_BATCH_SIZE=30
DISCOVERY_MIN_LIQUIDITY_USD=10000
DISCOVERY_MIN_VOLUME_24H_USD=5000
DISCOVERY_MAX_AGE_HOURS=48
DISCOVERY_MIN_TXNS_24H=10
DISCOVERY_REFRESH_STORED_TOKENS=true
DISCOVERY_REFRESH_STORED_LIMIT=200
DISCOVERY_RECOMMENDED_INTERVAL_MINUTES=15
# Automatic DexScreener collection while the backend process is running.
# Closing the terminal or stopping uvicorn stops collection. Single-process only.
AUTO_DISCOVERY_ENABLED=true
AUTO_DISCOVERY_INTERVAL_MINUTES=15
# Hard cap for one scan; runtime also keeps this strictly below the interval.
DISCOVERY_SCAN_DEADLINE_SECONDS=600
# After a power loss, if the last successful scan is overdue, wait this long then run one current scan (no backfill).
DISCOVERY_STARTUP_CATCHUP_DELAY_SECONDS=2
# Per-request bound including DNS; HTTP timeout remains DEXSCREENER_TIMEOUT_SECONDS.
DEXSCREENER_REQUEST_DEADLINE_SECONDS=20
NEWS_TIMEOUT_SECONDS=10
NEWS_MAX_ITEMS_PER_FEED=40
# Social adapters stay NOT_CONFIGURED unless you add credentials. Never store seed phrases.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
X_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_CHANNELS=
NARRATIVE_SCORE_MENTION_GROWTH=0.25
NARRATIVE_SCORE_ENGAGEMENT_GROWTH=0.20
NARRATIVE_SCORE_SOURCE_DIVERSITY=0.15
NARRATIVE_SCORE_RECENCY=0.15
NARRATIVE_SCORE_ACCELERATION=0.15
NARRATIVE_SCORE_PERSISTENCE=0.10
NARRATIVE_MATCH_MIN_CONFIDENCE=0.35
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_TIMEOUT_SECONDS=15
SOLANA_RPC_MAX_RETRIES=2
SOLANA_RPC_MAX_BACKOFF_SECONDS=5
SOLANA_RPC_STOP_AFTER_429=2
# After RATE_LIMITED, refuse RPC until until_at. Retry-After if present, else base * 2^(consecutive_429-1), capped.
SOLANA_RPC_COOLDOWN_BASE_SECONDS=5
SOLANA_RPC_COOLDOWN_MAX_SECONDS=60
# Mint signature pages of 1000. Truncation is UNKNOWN, never VERIFIED_ABSENT.
CREATOR_SIGNATURE_PAGE_LIMIT=20
SECURITY_MIN_COMPLETENESS=0.50
SECURITY_MIN_CONFIDENCE=0.50
SECURITY_HIGH_RISK_THRESHOLD=60
SECURITY_RESCAN_SECONDS=300
RISK_WEIGHT_AUTHORITIES=0.20
RISK_WEIGHT_HOLDERS=0.20
RISK_WEIGHT_LIQUIDITY=0.25
RISK_WEIGHT_TRADING=0.15
RISK_WEIGHT_DEPLOYER=0.20
OPPORTUNITY_WEIGHT_MOMENTUM=0.25
OPPORTUNITY_WEIGHT_NARRATIVE=0.25
OPPORTUNITY_WEIGHT_DISCOVERY=0.20
OPPORTUNITY_WEIGHT_LIQUIDITY=0.10
OPPORTUNITY_MAX_SECURITY_PENALTY=20
OPPORTUNITY_MIN_COMPLETENESS=0.40
OPPORTUNITY_MIN_CONFIDENCE=0.50
OPPORTUNITY_HIGH_THRESHOLD=70
OPPORTUNITY_WATCH_THRESHOLD=45
OPPORTUNITY_STALE_SNAPSHOT_HOURS=6
OPPORTUNITY_RESCAN_SECONDS=300
OPPORTUNITY_SCAN_LIMIT=50
# Creator mint-init scan. Manual only; no automatic recurring scan. Hard max 25.
CREATOR_SCAN_LIMIT=5
# Hypothetical round-trip cost for historical evaluation only. Not execution prices.
EVALUATION_FEE_BPS=30
EVALUATION_SLIPPAGE_BPS=50
EVALUATION_MAX_GAP_MINUTES=30
EVALUATION_MIN_SAMPLE_FOR_CLAIMS=30
# Stored-snapshot quality flags. Investigation only; not a safety or fraud verdict.
QUALITY_EXTREME_MOVE_MULTIPLE=10
QUALITY_EXTREME_REVERSAL=0.90
QUALITY_STALE_HOURS=6
QUALITY_LIQUIDITY_DISLOCATION_RATIO=20
